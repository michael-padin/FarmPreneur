//MARK: ADDRESS
model Address {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  fullAddress   String?
  contactName   String?
  contactNumber String?
  isDefault     Boolean?
  street        String?
  region        String?
  country       String?
  label         String?
  postalCode    String?
  latitude      Float
  longitude     Float
  note          String?
  locationType  String?
  order         Order[]
  farmer        Farmer?   @relation(fields: [farmerId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  farmerId      String?   @db.ObjectId
  customerId    String?   @db.ObjectId

  @@index([country, region])
  @@index([latitude, longitude])
  @@map("addresses")
}

// MARK: EMAIL OTP
model EmailOtp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  expiresAt DateTime
  email     String
  otp       String
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId

  @@unique([userId, email])
  @@index([email])
  @@index([expiresAt])
  @@map("email_otps")
}

// MARK: =====ENUMS=====

// MARK: DocumentType
enum DocumentType {
  TIN_ID
  NATIONAL_ID
  DRIVER_LICENSE
  VOTER_ID
  POSTAL_ID
  PASSPORT
}

// MARK: FarmerApplicationStatus
enum FarmerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// MARK: ImageType
enum ImageType {
  VERIFICATION
  PROFILE
  PRODUCT
  REVIEW
  THUMBNAIL
  FARM
  CATEGORY
}

// MARK: ImageStatus
enum ImageStatus {
  ACTIVE
  PROCESSING
  FAILED
  DELETED
}

// MARK: ReviewStatus
enum ReviewStatus {
  PENDING // Awaiting moderation
  PUBLISHED // Visible to public
  HIDDEN // Hidden by admin
  DELETED // Soft deleted
}

// MARK: OrderStatus
enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderSubStatus {
  // New/Created statuses
  AWAITING_FARMER_ACCEPTANCE

  // Active/In Progress statuses
  PREPARING_PRODUCE
  READY_FOR_PICKUP

  // Completed statuses
  PICKED_UP
  PAYMENT_PROCESSED
  BUYER_CONFIRMED
  FULLY_SETTLED
  BUYER_REVIEWED

  // Cancelled statuses
  CANCELLED_BY_FARMER
  CANCELLED_BY_BUYER
  INSUFFICIENT_STOCK
  PAYMENT_FAILED
  QUALITY_ISSUES
}

// MARK: ProductStatus
enum ProductListingStatus {
  PENDING
  APPROVED
  REJECTED
  OUT_OF_STOCK
  EXPIRED
  PAUSED
}

// MARK: NotificationType
enum NotificationType {
  ORDER_STATUS // Notification related to order status changes
  FARMER_APPROVAL
  PRODUCT_APPROVAL
  NEW_MESSAGE // Notification for new messages
  NEW_PRODUCT // Notification for new products listed
  PROMOTION // Notification for promotional offers
  SYSTEM_ALERT // System-related alerts or notifications
  VERIFICATION // Notifications related to account verification or status updates
}

// MARK: ROLE
enum ROLE {
  FARMER
  CUSTOMER
  ADMIN
}

enum Gender {
  MALE
  OTHER
  FEMALE
}
