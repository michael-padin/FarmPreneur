// MARK: NEW UPDATE 

datasource db {
  provider  = "mongodb"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// MARK: ACCOUNT
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// MARK: SESSION 
model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// MARK: TOKEN
model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// MARK: AUTHENTICATOR
// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @id @map("_id")
  userId               String  @db.ObjectId
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, credentialID])
}

// MARK: USER
model User {
  id                  String                 @id @default(auto()) @map("_id") @db.ObjectId
  name                String?
  email               String?                
  emailVerified       DateTime?
  image               String?
  accounts            Account[]
  sessions            Session[]
  role                ROLE
  password            String?
  contactNumber       String?
  isVerified          Boolean                @default(false)
  verificationCode    String?
  verificationExpires DateTime?
  // Optional for WebAuthn support
  Authenticators      Authenticator[]
  profilePicture      String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  products            Product[]
  buyerOrders         Order[]                @relation("BuyerOrders")
  farmerOrders        Order[]                @relation("FarmerOrders")
  verficationDocument VerificationDocument[]
  farmerDetails                Farm?
  notifications       Notification[]
  address             Address?

  @@unique([email])
}

// MARK: PRODUCT
model Product {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  price       Float
  unit        String?
  quantity    Int
  images      String[]
  location    String
  farmer      User      @relation(fields: [farmerId], references: [id]) // Farmer creates the product
  farmerId    String    @db.ObjectId
  isApproved  Boolean   @default(false) // For marketplace admin approval
  orders      Order[] // Products can have multiple orders
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  String?   @db.ObjectId
}

// MARK: ORDER
model Order {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  quantityPurchased Int
  totalPrice        Float
  status            Status   @default(IN_PROGRESS)
  buyer             User     @relation("BuyerOrders", fields: [buyerId], references: [id]) // Buyer places the order
  buyerId           String   @db.ObjectId
  productId         String   @db.ObjectId
  shippingAddress   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  product           Product  @relation(fields: [productId], references: [id]) // Order refers to the product
  farmerId          String   @db.ObjectId
  farmer            User     @relation("FarmerOrders", fields: [farmerId], references: [id]) // Order refers to the product
  address           Address? @relation(fields: [addressId], references: [id])
  addressId         String?  @db.ObjectId

  @@unique([buyerId, productId, farmerId])
}

// MARK: CATEGORY
model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String // Category name (e.g., Fruits, Vegetables, Dairy)
  description String? // Optional description of the category
  products    Product[] // Products belonging to this category
}

model VerificationDocument {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  type      DocumentType // Type of document (ID, License, Certification)
  url       String // URL to the uploaded document
  user      User         @relation(fields: [userId], references: [id])
  userId    String       @db.ObjectId
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// MARK: FARM
model Farm {
  id                      String                   @id @default(auto()) @map("_id") @db.ObjectId
  applicationStatus FarmerApplicationStatus?
  name                    String // Farm name
  description             String // Description of the farmerDetails
  location                String // Farm location
  yearsOfExperience       Int // Farmer's experience in years
  size                    Float? // Optional, farmerDetails size in acres or hectares
  products                String[] // Products grown/raised by the farmer
  images                  String[] // Image URLs of the farmerDetails
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  farmerId                String                   @db.ObjectId
  farmer                  User                     @relation(fields: [farmerId], references: [id])

  @@unique([farmerId])
}

// MARK: NOTIFICATION
model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId // Reference to the user receiving the notification
  message   String // Notification message
  isRead    Boolean          @default(false) // Status indicating if the notification has been read
  createdAt DateTime         @default(now()) // Timestamp for when the notification was created
  type      NotificationType // Type of notification (e.g., ORDER_STATUS, NEW_MESSAGE, etc.)

  user User @relation(fields: [userId], references: [id]) // Relation back to the User
}

//MARK: ADDRESS
model Address {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  user         User     @relation(fields: [userId], references: [id])
  userId       String   @db.ObjectId // Reference to the user receiving the notification
  fullAddress  String
  street       String?
  region       String?
  country      String?
  postalCode   String?
  latitude     Float
  longitude    Float
  note         String?
  locationType String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  order        Order[]

  @@unique([userId])
}

// MARK: ENUMS
enum DocumentType {
  GOVERNMENT_ID
  BUSINESS_LICENSE
  FARM_CERTIFICATION
}

enum FarmerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
}

// ENUM for Notification Types
enum NotificationType {
  ORDER_STATUS // Notification related to order status changes
  NEW_MESSAGE // Notification for new messages
  NEW_PRODUCT // Notification for new products listed
  PROMOTION // Notification for promotional offers
  SYSTEM_ALERT // System-related alerts or notifications
  VERIFICATION // Notifications related to account verification or status updates
}

enum ROLE {
  FARMER
  CUSTOMER
  ADMIN
}
