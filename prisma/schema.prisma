//MARK: ADDRESS
model Address {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String?      @unique @db.ObjectId
  farmDetails   FarmDetails? @relation(fields: [farmDetailsId], references: [id], onDelete: Cascade)
  fullAddress   String?
  street        String?
  region        String?
  country       String?
  postalCode    String?
  latitude      Float
  longitude     Float
  note          String?
  locationType  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  order         Order[]
  product       Product[]
  farmDetailsId String?      @unique @db.ObjectId

  @@index([country, region])
  @@index([latitude, longitude])
}

// MARK: EMAIL OTP
model EmailOtp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, email])
  @@index([email])
  @@index([expiresAt])
}

// MARK: =====ENUMS=====

// MARK: DocumentType
enum DocumentType {
  PHILIPPINE_NATIONAL_ID
  DRIVER_LICENSE // Driver's License (LTO)
  BUSINESS_PERMIT // DTI Business Permit (for businesses)
  PASSPORT // Philippine Passport
  SSS_ID // Social Security System ID
  TIN_ID // Tax Identification Number (TIN)
  UMID // Unified Multi-Purpose ID
  PRC_ID // Professional Regulation Commission ID (for licensed professionals)
  POSTAL_ID // Postal ID
  VOTER_ID // Voter's ID (COMELEC)
  SENIOR_CITIZEN_ID // Senior Citizen ID (for elderly verification)
  OFW_ID // Overseas Filipino Worker ID
  MAYORS_PERMIT // Mayor's Permit (local business requirement)
  BIR_CERTIFICATE // Bureau of Internal Revenue Certificate (for tax purposes)
  BARANGAY_CLEARANCE // Barangay Clearance (for address verification)
  CEDULA // Community Tax Certificate (Cedula, often used as supplementary ID)
}

// MARK: FarmerApplicationStatus
enum FarmerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// MARK: ImageType
enum ImageType {
  VERIFICATION
  PROFILE
  PRODUCT
  REVIEW
  THUMBNAIL
  FARM
}

// MARK: ImageStatus
enum ImageStatus {
  ACTIVE
  PROCESSING
  FAILED
  DELETED
}

// MARK: ReviewStatus
enum ReviewStatus {
  PENDING // Awaiting moderation
  PUBLISHED // Visible to public
  HIDDEN // Hidden by admin
  DELETED // Soft deleted
}

// MARK: OrderStatus
enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
}

// MARK: ProductStatus
enum ProductListingStatus {
  PENDING
  APPROVED
  REJECTED
}

// MARK: NotificationType
enum NotificationType {
  ORDER_STATUS // Notification related to order status changes
  NEW_MESSAGE // Notification for new messages
  NEW_PRODUCT // Notification for new products listed
  PROMOTION // Notification for promotional offers
  SYSTEM_ALERT // System-related alerts or notifications
  VERIFICATION // Notifications related to account verification or status updates
}

// MARK: ROLE
enum ROLE {
  FARMER
  CUSTOMER
  ADMIN
}
