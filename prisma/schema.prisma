// MARK: NEW UPDATE 

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

// MARK: ACCOUNT
model Account {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.String
  access_token      String?  @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.String
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// MARK: SESSION 
model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// MARK: TOKEN
model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

// MARK: AUTHENTICATOR
// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @id @map("_id")
  userId               String  @db.ObjectId
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, credentialID])
  @@index([userId])
}

// MARK: USER
model User {
  id                      String                   @id @default(auto()) @map("_id") @db.ObjectId
  name                    String?
  email                   String
  emailVerified           DateTime?
  image                   String?
  accounts                Account[]
  sessions                Session[]
  role                    ROLE
  password                String?
  contactNumber           String?
  isEmailVerified         Boolean                  @default(false)
  Authenticators          Authenticator[]
  profilePicture          String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  farmerApplicationStatus FarmerApplicationStatus?
  products                Product[]
  buyerOrders             Order[]                  @relation("BuyerOrders")
  farmerOrders            Order[]                  @relation("FarmerOrders")
  notifications           Notification[]
  verficationDocument     VerificationDocument?
  farmDetails             FarmDetails?
  address                 Address?
  birthDate               DateTime?
  emailOtp                EmailOtp[]
  reviews                 ProductReview[]

  @@unique([email])
  @@index([role])
}

// MARK: PRODUCT
model Product {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String
  price          Float
  unit           String?
  listingStatus  ProductListingStatus @default(PENDING)
  quantity       Int
  images         Image[]
  pickupLocation Address?             @relation(fields: [addressId], references: [id])
  farmer         User                 @relation(fields: [farmerId], references: [id]) // Farmer creates the product
  farmerId       String               @db.ObjectId
  orders         Order[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  category       Category?            @relation(fields: [categoryId], references: [id])
  categoryId     String?              @db.ObjectId
  reviews        ProductReview[]
  addressId      String               @db.ObjectId

  @@index([farmerId])
  @@index([categoryId])
  @@index([createdAt])
}

// MARK: PRODUCT REVIEW
model ProductReview {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  rating         Float
  comment        String?
  images         Image[]
  status         ReviewStatus @default(PUBLISHED)
  userId         String       @db.ObjectId
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId      String       @db.ObjectId
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId        String       @unique @db.ObjectId
  order          Order        @relation(fields: [orderId], references: [id])
  farmerResponse String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, orderId])
  @@index([productId, status])
  @@index([userId])
  @@index([createdAt])
}

// MARK: IMAGE
model Image {
  id                     String                @id @default(auto()) @map("_id") @db.ObjectId
  url                    String // Cloud storage URL
  type                   ImageType // Type of image (product, review, etc)
  filename               String // Original filename
  size                   Int // File size in bytes
  mimeType               String // e.g., "image/jpeg", "image/png"
  width                  Int? // Image width in pixels
  height                 Int? // Image height in pixels
  order                  Int                   @default(0) // Display order for multiple images
  isPrimary              Boolean               @default(false)
  productId              String?               @db.ObjectId
  product                Product?              @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewId               String?               @db.ObjectId
  review                 ProductReview?        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  altText                String? // For accessibility
  caption                String? // Optional image caption
  status                 ImageStatus           @default(ACTIVE)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  farmDetails            FarmDetails?          @relation(fields: [farmDetailsId], references: [id])
  farmDetailsId          String?               @db.ObjectId
  verificationDocumentId String?               @unique @db.ObjectId
  VerificationDocument   VerificationDocument?

  @@unique([productId, isPrimary])
  @@index([productId, order])
  @@index([reviewId])
  @@index([status])
}

// MARK: ORDER
model Order {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  quantityPurchased Int
  totalPrice        Float
  status            OrderStatus    @default(IN_PROGRESS)
  buyer             User           @relation("BuyerOrders", fields: [buyerId], references: [id]) // Buyer places the order
  buyerId           String         @db.ObjectId
  productId         String         @db.ObjectId
  shippingAddress   String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade) // Order refers to the product
  farmerId          String         @db.ObjectId
  farmer            User           @relation("FarmerOrders", fields: [farmerId], references: [id]) // Order refers to the product
  address           Address?       @relation(fields: [addressId], references: [id])
  addressId         String?        @db.ObjectId
  review            ProductReview?

  @@unique([buyerId, farmerId])
  @@index([status, productId])
  @@index([createdAt])
  @@index([buyerId])
  @@index([farmerId])
}

// MARK: CATEGORY
model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String // Category name (e.g., Fruits, Vegetables, Dairy)
  description String? // Optional description of the category
  products    Product[] // Products belonging to this category

  @@index([name])
}

// MARK: VERIFICATION DOC
model VerificationDocument {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  type      DocumentType // Type of document (ID, License, Certification)
  image     Image        @relation(fields: [imageId], references: [id])
  imageId   String       @unique @db.ObjectId
  user      User         @relation(fields: [userId], references: [id])
  userId    String       @unique @db.ObjectId
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([type])
}

// MARK: FARM
model FarmDetails {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  farmName        String?
  farmDescription String
  products        String[]
  images          Image[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  farmerId        String   @unique @db.ObjectId
  farmer          User     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  address         Address?
  addressId       String?  @db.ObjectId
}

// MARK: NOTIFICATION
model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId // Reference to the user receiving the notification
  message   String // Notification message
  isRead    Boolean          @default(false) // Status indicating if the notification has been read
  createdAt DateTime         @default(now()) // Timestamp for when the notification was created
  type      NotificationType // Type of notification (e.g., ORDER_STATUS, NEW_MESSAGE, etc.)
  user      User             @relation(fields: [userId], references: [id]) // Relation back to the User

  @@index([userId, isRead])
  @@index([createdAt])
}

