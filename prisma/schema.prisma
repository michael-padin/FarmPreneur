// MARK: USER
model User {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  name             String?
  email            String
  emailVerified    DateTime?
  image            String?
  role             ROLE
  password         String?
  isEmailVerified  Boolean        @default(false)
  profilePicture   Image?         @relation(fields: [profilePictureId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profilePictureId String?        @unique @db.ObjectId
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  notifications    Notification[]
  emailOtp         EmailOtp[]
  farmer           Farmer?
  customer         Customer?

  // accounts        Account[]
  // sessions        Session[]
  // Authenticators  Authenticator[]

  @@unique([email])
  @@index([role])
  @@map("users")
}

// MARK: FARMER
model Farmer {
  id                   String                   @id @default(auto()) @map("_id") @db.ObjectId
  farmName             String?
  farmDescription      String?
  gender               Gender?
  coverPhoto           String?
  profilePicture       String?
  applicationStatus    FarmerApplicationStatus?
  contactNumber        String?
  verificationDocument VerificationDocument?
  userId               String                   @unique @db.ObjectId
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  birthDate            DateTime?
  address              Address[]
  orders               Order[]
  products             Product[]
  farmImages           Image[]

  @@index([applicationStatus])
  @@map("farmers")
}

// MARK: CUSTOMER
model Customer {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  contactNumber  String?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String          @unique @db.ObjectId
  address        Address[]
  orders         Order[]
  name           String?
  profilePicture String?
  coverPhoto     String?
  bio            String?
  cart           Cart?
  birthDate      DateTime?
  wishlist       WishlistItem[]
  reviews        ProductReview[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  gender         Gender?

  @@map("customers")
}

// MARK: CART
model Cart {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  items      CartItem[]
  customer   Customer   @relation(fields: [customerId], references: [id])
  customerId String     @unique @db.ObjectId

  @@map("carts")
}

// MARK: CART ITEM
model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quantity  Int
  product   Product  @relation(fields: [productId], references: [id])
  productId String   @db.ObjectId
  updatedAt DateTime @updatedAt // Time the cart item was last updated
  addedAt   DateTime @default(now()) // Time the item was added to the cart
  cart      Cart?    @relation(fields: [cartId], references: [id])
  cartId    String?  @db.ObjectId

  @@map("cart_items")
}

// MARK: WISHLIST ITEM
model WishlistItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id])
  productId  String   @db.ObjectId
  addedAt    DateTime @default(now()) // Time the item was added to the wishlist

  @@unique([customerId, productId])
  @@index([customerId])
  @@map("wishlist_items")
}

// MARK: PRODUCT
model Product {
  id            String               @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  title         String
  description   String
  price         Float
  productImages String[]
  slug          String?              @unique
  unit          String?
  quantity      Int
  listingStatus ProductListingStatus @default(PENDING)
  category      Category?            @relation(fields: [categoryId], references: [id])
  categoryId    String?              @db.ObjectId
  farmer        Farmer?              @relation(fields: [farmerId], references: [id])
  farmerId      String?              @db.ObjectId
  cartItems     CartItem[]
  images        Image[]
  reviews       ProductReview[]
  wishlistItems WishlistItem[]
  orderItem     OrderItem[]

  @@index([categoryId])
  @@index([farmerId])
  @@index([listingStatus])
  @@index([createdAt])
  @@map("products")
}

// MARK: PRODUCT REVIEW
model ProductReview {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  rating         Float
  comment        String?
  status         ReviewStatus @default(PUBLISHED)
  farmerResponse String?
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String       @db.ObjectId
  customer       Customer?    @relation(fields: [customerId], references: [id])
  customerId     String?      @db.ObjectId
  images         Image[]

  @@index([productId, status])
  @@index([createdAt])
  @@map("product_reviews")
}

// MARK: IMAGE
model Image {
  id                   String                @id @default(auto()) @map("_id") @db.ObjectId
  createdAt            DateTime              @default(now())
  path                 String?
  updatedAt            DateTime              @updatedAt
  url                  String // Cloud storage URL 
  type                 ImageType // Type of image (product, review, etc)
  filename             String // Original filename
  size                 Int // File size in bytes
  mimeType             String // e.g., "image/jpeg", "image/png"
  width                Int? // Image width in pixels
  height               Int? // Image height in pixels
  order                Int                   @default(0) // Display order for multiple images
  isPrimary            Boolean               @default(false)
  altText              String? // For accessibility
  caption              String? // Optional image caption
  status               ImageStatus           @default(ACTIVE)
  reviewId             String?               @db.ObjectId
  productId            String?               @db.ObjectId
  product              Product?              @relation(fields: [productId], references: [id])
  review               ProductReview?        @relation(fields: [reviewId], references: [id])
  user                 User?
  VerificationDocument VerificationDocument?
  category             Category?
  farmer               Farmer?               @relation(fields: [farmerId], references: [id])
  farmerId             String?               @db.ObjectId // Reference to the farmer

  @@index([productId, order])
  @@index([reviewId])
  @@index([status])
  @@map("images")
}

// MARK: ORDER
model Order {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  quantity           Int?
  totalPrice         Float?
  status             OrderStatus    @default(PENDING)
  subStatus          OrderSubStatus @default(AWAITING_FARMER_ACCEPTANCE)
  pickupLocation     Address?       @relation(fields: [pickupLocationId], references: [id])
  pickupLocationId   String?        @db.ObjectId
  farmer             Farmer         @relation(fields: [farmerId], references: [id])
  farmerId           String         @db.ObjectId
  customer           Customer?      @relation(fields: [customerId], references: [id])
  customerId         String?        @db.ObjectId
  cancellationReason String?
  items              OrderItem[]

  @@index([status])
  @@index([customerId])
  @@index([farmerId])
  @@index([createdAt])
  @@map("orders")
}

// MARK: ORDER ITEM
model OrderItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  quantity  Int
  price     Float // Store the price at the time of order for historical accuracy
  orderId   String  @db.ObjectId
  order     Order   @relation(fields: [orderId], references: [id])
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// MARK: CATEGORY
model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String // Category name (e.g., Fruits, Vegetables, Dairy)
  description String? // Optional description of the category
  slug        String?   @unique
  image       Image?    @relation(fields: [imageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products    Product[] // Products belonging to this category
  imageId     String?   @unique @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
  @@map("categories")
}

// MARK: VERIFICATION DOC
model VerificationDocument {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  type      DocumentType? // Type of document (ID, License, Certification)
  image     Image?        @relation(fields: [imageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  imageId   String?       @unique @db.ObjectId // Reference to the image
  farmer    Farmer?       @relation(fields: [farmerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  farmerId  String?       @unique @db.ObjectId // Reference to the farmer

  @@index([type])
  @@map("verification_documents")
}

// MARK: NOTIFICATION
model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime         @default(now()) // Timestamp for when the notification was created
  title     String // Notification message
  message   String // Notification message
  isRead    Boolean          @default(false) // Status indicating if the notification has been read
  type      NotificationType // Type of notification (e.g., ORDER_STATUS, NEW_MESSAGE, etc.)
  user      User             @relation(fields: [userId], references: [id]) // Relation back to the User
  userId    String           @db.ObjectId // Reference to the user receiving the notification

  metadata Json? @default("{}") // Additional metadata for the notification

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

