//MARK: ADDRESS
model Address {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  fullAddress   String?
  contactName   String?
  contactNumber String?
  isDefault     Boolean?
  street        String?
  region        String?
  country       String?
  label         String?
  postalCode    String?
  latitude      Float
  longitude     Float
  note          String?
  locationType  String?
  farmer        Farmer?   @relation(fields: [farmerId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  farmerId      String?   @db.ObjectId
  customerId    String?   @db.ObjectId
  order         Order[]   @relation("CustomerContact")
  Order         Order[]   @relation("PickupLocation")

  @@index([country, region])
  @@index([latitude, longitude])
  @@map("addresses")
}

// MARK: EMAIL OTP
model EmailOtp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  expiresAt DateTime
  email     String
  otp       String
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId

  @@unique([userId, email])
  @@index([email])
  @@index([expiresAt])
  @@map("email_otps")
}

// MARK: =====ENUMS=====

// MARK: DocumentType
enum DocumentType {
  TIN_ID
  NATIONAL_ID
  DRIVER_LICENSE
  VOTER_ID
  POSTAL_ID
  PASSPORT
}

// MARK: FarmerApplicationStatus
enum FarmerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// MARK: ImageType
enum ImageType {
  VERIFICATION
  PROFILE
  PRODUCT
  REVIEW
  THUMBNAIL
  FARM
  CATEGORY
}

// MARK: ImageStatus
enum ImageStatus {
  ACTIVE
  PROCESSING
  FAILED
  DELETED
}

// MARK: ReviewStatus
enum ReviewStatus {
  PENDING // Awaiting moderation
  PUBLISHED // Visible to public
  HIDDEN // Hidden by admin
  DELETED // Soft deleted
}

// MARK: OrderStatus
enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderSubStatus {
  // Order Initiation: Buyer creates the order and awaits farmer's response
  ORDER_PLACED // Buyer has placed the order and it's awaiting farmer's review

  // Farmer Actions: Farmer processes the order
  ORDER_ACCEPTED // Farmer accepts the order and confirms the availability of produce
  PREPARING_PRODUCE // Farmer begins preparing the produce (harvesting, packing, etc.)
  PRODUCE_READY_FOR_PICKUP // Produce is ready for pickup or delivery

  //Buyer Actions: Buyer collects or interacts with the order
  PICKED_UP_BY_BUYER // Buyer has picked up the order from the farm or pickup point
  PAYMENT_PENDING // Payment is pending after the order is accepted but before processing
  PAYMENT_PROCESSED // Payment is successfully processed and confirmed
  BUYER_CONFIRMED_ORDER // Buyer confirms they’ve received the order and it’s as expected

  // Completion & Feedback: Final stages of transaction and order settlement
  BUYER_REVIEWED // Buyer leaves feedback or reviews the farmer and order experience
  ORDER_COMPLETED // Order process is complete, and all tasks are done
  FULLY_SETTLED // Financially, the order is fully settled, no further action required

  // Cancellations & Issues: If the order is cancelled or has problems
  ORDER_REJECTED // Farmer rejects the order, either due to availability or other reasons
  ORDER_CANCELLED
  INSUFFICIENT_STOCK // Farmer cancels the order because they don’t have enough stock to fulfill it
  PAYMENT_FAILED // Payment failed due to a technical or financial issue
  QUALITY_ISSUES // Farmer or buyer cancels due to issues with the produce’s quality
  ORDER_EXPIRED // Order was not processed in time and has expired, no action taken
  NO_SHOW_AT_PICKUP // Buyer failed to show up at the agreed pickup time 
  PICKUP_DELAYED // Pickup delayed due to unforeseen circumstances
}

// MARK: ProductStatus
enum ProductListingStatus {
  PENDING
  APPROVED
  REJECTED
  OUT_OF_STOCK
  UNLISTED
  EXPIRED
  PAUSED
}

// MARK: NotificationType
enum NotificationType {
  ORDER_STATUS // Notification related to order status changes
  FARMER_APPROVAL
  PRODUCT_APPROVAL
  NEW_MESSAGE // Notification for new messages
  NEW_PRODUCT // Notification for new products listed
  PROMOTION // Notification for promotional offers
  SYSTEM_ALERT // System-related alerts or notifications
  VERIFICATION // Notifications related to account verification or status updates
}

// MARK: ROLE
enum ROLE {
  FARMER
  CUSTOMER
  ADMIN
}

enum Gender {
  MALE
  OTHER
  FEMALE
}
