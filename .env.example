TWITTER_SITE="https://michaelpadin.netlify.app"
SITE_NAME="FarmPreneur"


# base url
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# MARK: database url
DATABASE_URL=mongodb://localhost:27017/dbname

# MARK: next auth 
AUTH_SECRET=authsecret
AUTH_GOOGLE_ID=googleid
AUTH_GOOGLE_SECRET=googlesecret

# MARK: mapbox
MAP_BOX_SECRET_KEY=sk.token
NEXT_PUBLIC_MAP_BOX_PUBLIC_KEY=pk.token

# MARK: nodemailer
NODE_MAILER_USER="fistlast@gmail.com"
NODE_MAILER_PASSWORD="dddd ffff aaaa eeee"

# MARK: jwt
JWT_SECRET=uniquesecret

# MARK: cloudflare
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://
CLOUDFLARE_R2_BUCKET_NAME=farmpreneur
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_API_TOKEN=
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_DOMAIN=https://

# MARK: pusher
PUSHER_APP_ID=1890517
NEXT_PUBLIC_PUSHER_KEY=2ba364ef5e989d182212
PUSHER_SECRET=e6eb4eaf11cb379679d6
NEXT_PUBLIC_PUSHER_CLUSTER=ap1

# MARK: security / rate limiting
# Set this in Vercel and Vercel will send `Authorization: Bearer <CRON_SECRET>` to /api/cron
CRON_SECRET=

# Optional distributed store for rate limiting across Vercel instances
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Global traffic limits
RATE_LIMIT_GLOBAL_READ_LIMIT=240
RATE_LIMIT_GLOBAL_READ_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_WRITE_LIMIT=120
RATE_LIMIT_GLOBAL_WRITE_WINDOW_MS=60000
RATE_LIMIT_SERVER_ACTION_LIMIT=50
RATE_LIMIT_SERVER_ACTION_WINDOW_MS=60000

# Sensitive auth limits
RATE_LIMIT_AUTH_LIMIT=20
RATE_LIMIT_AUTH_WINDOW_MS=600000
RATE_LIMIT_SIGNUP_LIMIT=8
RATE_LIMIT_SIGNUP_WINDOW_MS=900000
RATE_LIMIT_PASSWORD_RESET_LIMIT=6
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=900000
RATE_LIMIT_VERIFY_EMAIL_LIMIT=20
RATE_LIMIT_VERIFY_EMAIL_WINDOW_MS=600000

# File/cron endpoint limits
RATE_LIMIT_UPLOAD_LIMIT=40
RATE_LIMIT_UPLOAD_WINDOW_MS=300000
RATE_LIMIT_DELETE_FILE_LIMIT=20
RATE_LIMIT_DELETE_FILE_WINDOW_MS=300000
RATE_LIMIT_CRON_LIMIT=5
RATE_LIMIT_CRON_WINDOW_MS=3600000

